@startuml

left to right direction
actor 贷款人 as user

rectangle "贷款申请" as system {
    usecase "实名认证与银行卡绑定" as UC1
    usecase "申请贷款" as UC2
    usecase "签订贷款合同" as UC3
    usecase "查看贷款进度" as UC4
    ' UC1 <.. UC2 : <<include>>
    ' UC2 <.. UC3 : <<include>>
    UC3 ..> UC4 : <<extend>>
}
user -> UC1 
user -> UC2
user -> UC3
user -> UC4

@enduml