@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 180
skinparam padding 8
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #444444
skinparam classHeaderBackgroundColor #F0F0F0

class "UserAccount\n账户" as U {
  userId: int
  username: String
  passwordHash: String
  role: Role
}
class "UserIdentity\n实名身份" as I {
  identityId: int
  name: String
  verifyStatus: String
}
class "UserBankCard\n银行卡" as B {
  cardId: int
  cardNumber: String
  bankName: String
}
class "ThirdPartyData\n第三方数据" as T {
  thirdPartyId: int
  sourceName: String
  data: JSON
}
class "LoanApplication\n贷款申请" as L {
  applicationId: int
  amount: BigDecimal
  term: int
  status: ApplicationStatus
}
class "ApplicationMaterial\n申请材料" as M {
  materialId: int
  materialType: String
  content: String
}
class "RiskAssessment\n模型风险评估" as R {
  assessmentId: int
  modelVersion: String
  riskLevel: RiskLevel
}
class "AssessmentReport\n模型评估报告" as A {
  reportId: int
  content: String
}
class "ManualAssessment\n人工评估" as V {
  manualAssessmentId: int
  result: ReviewResult
  opinion: String
}
U "1" -- "0..1" I
U "1" -- "0..*" B
U "1" -- "0..*" T
U "1" -- "0..*" L
L "1" -- "0..*" M
L "1" -- "0..*" R
R "1" -- "1..*" A
R "1" -- "0..1" V
I -[hidden]right- B
B -[hidden]right- T
M -[hidden]right- R
A -[hidden]right- V
@enduml
