@startuml
skinparam classAttributeIconSize 0
\
interface DataSourceAdapter {
  + collect(userId: String, purpose: String, auth: AuthInfo, timeWindow: TimeWindow): DataSourceResult
}
note bottom of DataSourceAdapter
  职责：封装用户填报、内部记录和第三方来源，
  输出来源及采集状态。
end note

interface FusionService {
  + fuse(records: List<Record>, policyVersion: String): FeatureSnapshot
}
note bottom of FusionService
  职责：统一字段、判定冲突、记录血缘与质量。
end note


class FeatureSnapshot {
  - fusedData: Map<String, Object>
  - timeAnchor: Date
  - featureVersion: String
  - missingFlags: List<String>
  - conflictFlags: List<String>
}
note bottom of FeatureSnapshot
  职责：不可变评估输入；绑定申请版本。
end note


interface RiskAssessmentService {
  + assess(modelResult: ModelResult, ruleResult: RuleResult, qualityMark: QualityMark): RiskAssessment
}
note bottom of RiskAssessmentService
  职责：形成可解释风险依据，质量不足则生成待复核状态。
end note


DataSourceAdapter ..> DataSourceResult : 输出 >
FusionService ..> FeatureSnapshot : 输出 >
FeatureSnapshot ..> RiskAssessmentService : 作为输入 >
RiskAssessmentService ..> RiskAssessment : 输出 >

@enduml