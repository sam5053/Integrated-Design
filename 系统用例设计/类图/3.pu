@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam classFontSize 18
skinparam classAttributeFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 180
skinparam padding 8
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #444444
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #444444
skinparam classHeaderBackgroundColor #F0F0F0

class "LoanContract\n贷款合同" as C {
  contractId: int
  applicationId: int
  signStatus: String
}
class "ElectronicSignature\n电子签名" as S {
  signatureId: int
  image: byte[]
  signedAt: LocalDateTime
}
class "PaymentRecord\n支付记录" as P {
  paymentId: int
  number: String
  amount: BigDecimal
  status: String
}
class "DisbursementRecord\n放款记录" as D {
  disbursementId: int
  amount: BigDecimal
  status: String
}
C "1" -- "0..1" S
C "1" -- "0..*" D
P "1" -- "0..1" D
S -[hidden]right- P
@enduml
